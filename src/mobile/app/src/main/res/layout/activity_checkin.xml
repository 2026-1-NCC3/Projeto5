<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_back"
                android:padding="4dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check-in"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registro seu nível de dor"
                    android:textSize="13sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card info azul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_blue_light"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_dialog_info"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avaliação de Dor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#37A6BA" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registre seu nível de dor atual para ajudar no\nacompanhamento do tratamento."
                    android:textSize="12sp"
                    android:textColor="#37A6BA" />
            </LinearLayout>
        </LinearLayout>

        <!-- Label nível de dor + badge + descrição -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nível de Dor:"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:id="@+id/tvNivelNumero"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="5"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_circle_teal"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvNivelDescricao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dor moderada"
                android:textSize="13sp"
                android:textColor="#888888" />
        </LinearLayout>

        <!-- Botões 1-10 -->
        <LinearLayout
            android:id="@+id/llNiveis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp" />

        <!-- Sem dor / Dor máxima -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sem dor"
                android:textSize="11sp"
                android:textColor="#AAAAAA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dor máxima"
                android:textSize="11sp"
                android:textColor="#AAAAAA" />
        </LinearLayout>

        <!-- Comentários -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comentários (opcional)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etComentario"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Descreva como você está se sentindo, se teve\ndificuldades com algum exercício, etc."
            android:textSize="13sp"
            android:textColor="#1A1A1A"
            android:textColorHint="#BBBBBB"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:maxLength="200"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvContador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="0/200"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="24dp" />

        <!-- Botão finalizar -->
        <Button
            android:id="@+id/btnFinalizar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Finalizar Check-in"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/teal"
            android:stateListAnimator="@null"
            android:layout_marginBottom="20dp" />

        <!-- Card rodapé -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_blue_light"
            android:padding="14dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_dialog_info"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seu registro de dor ajuda a fisioterapeuta a acompanhar sua evolução e ajustar o tratamento conforme necessário."
                android:textSize="12sp"
                android:textColor="#37A6BA" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>