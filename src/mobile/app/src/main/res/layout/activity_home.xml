                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:background="@drawable/circulo_pendente"
                                app:srcCompat="@drawable/ic_setadash" app:tint="#E57373" android:padding="6dp" />
                            <TextView android:id="@+id/txt_prog_proximos" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="0"
