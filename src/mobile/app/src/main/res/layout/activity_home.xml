                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Próximos" android:textSize="10sp" android:textColor="#999999" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
